{
  "name": "center",
  "version": "2.0.0",
  "private": true,
  "description": "Center Service Application",
  "homepage": "https://github.com/OmarEhab262/center252#readme",
  "bugs": {
    "url": "https://github.com/OmarEhab262/center252/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OmarEhab262/center252.git"
  },
  "license": "ISC",
  "author": "Omar Ehab",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron": "electron .",
    "rebuild": "electron-rebuild",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/cairo": "^5.3.0",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.2.0",
    "@tailwindcss/vite": "^4.3.2",
    "crypto-js": "^4.2.0",
    "html2canvas-pro": "^2.3.3",
    "jspdf": "^4.2.1",
    "react": "^19.2.7",
    "react-datepicker": "^9.1.0",
    "react-dom": "^19.2.7",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.18.1",
    "react-to-print": "^3.3.0",
    "sql.js": "^1.11.0",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^43.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "vite": "^8.1.1",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "build": {
    "appId": "com.omar.center",
    "productName": "Center Service",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
